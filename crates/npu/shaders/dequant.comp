#version 450
// Y[r][c] = float(C[r][c]) * sx[r] * sw[c], reading the NPU's int32 C straight from the shared dma-buf.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer C { ivec4 c[]; };
layout(std430, binding = 1) readonly buffer SX { float sx[]; };
layout(std430, binding = 2) readonly buffer SW { vec4 sw[]; };
layout(std430, binding = 3) writeonly buffer Y { vec4 y[]; };
layout(push_constant) uniform P { uint N4; uint total4; } p;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.total4) return;
  uint r = i / p.N4, c4 = i % p.N4;
  y[i] = vec4(c[i]) * sx[r] * sw[c4];
}
