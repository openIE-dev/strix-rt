#version 450
// LFM2 double-gated short conv, one decode step. bcx = in_proj(x) = [B | C | X] (3*dim).
// bx = B*X; y = C * (w0*s[t-2] + w1*s[t-1] + w2*bx) with conv taps w[c*3 + k] (oldest first); state <- (s[t-1], bx).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer BCX { float bcx[]; };
layout(std430, binding = 1) buffer ST { float st[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(std430, binding = 3) readonly buffer F { float f32w[]; };
layout(push_constant) uniform PC { uint dim; uint st_off; uint w_off; } pc;
void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.dim) return;
    float bx = bcx[c] * bcx[2u * pc.dim + c];
    uint so = pc.st_off + 2u * c;
    float s0 = st[so], s1 = st[so + 1u];
    uint wo = pc.w_off + 3u * c;
    float v = f32w[wo] * s0 + f32w[wo + 1u] * s1 + f32w[wo + 2u] * bx;
    st[so] = s1; st[so + 1u] = bx;
    y[c] = bcx[pc.dim + c] * v;
}
