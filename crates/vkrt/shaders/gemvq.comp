void main() {
    q_any_init(pc.types);
#ifdef SWIGLU
    if (Q4P != 0u && TY == 0u && TYU == 0u && NB == 1u && FNB == 0u && NRS == 1u && (pc.flags & 64u) != 0u) { if ((Q4P & 1u) == 1u) { main_q4p_sw(); return; } }
#endif
#ifndef SWIGLU
    if (Q4P != 0u && TY <= 1u && NB == 1u && FNB == 0u && NRS == 1u && (pc.flags & 64u) != 0u) { if (((Q4P >> TY) & 1u) == 1u) { main_q4p(); return; } }
#endif
    if (NB > 1u || FNB != 0u || ((pc.flags & 32u) != 0u && (TY == 8u || TY == 9u || TY == 12u))) { main_nb(); return; }
    if (NRS > 1u) { main_nr(); return; }
    uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint rps = gl_SubgroupSize / LPR, lane = gl_SubgroupInvocationID % LPR;
    uint row = (wg * gl_NumSubgroups + gl_SubgroupID) * rps + gl_SubgroupInvocationID / LPR;
    bool valid = row < pc.N;
    uint seg = row < pc.r1 ? 0u : row < pc.r2 ? 1u : row < pc.r3 ? 2u : 3u;
    uint lrow = row - (seg == 0u ? 0u : seg == 1u ? pc.r1 : seg == 2u ? pc.r2 : pc.r3);
    uint woff = seg == 0u ? pc.w0 : seg == 1u ? pc.w1 : seg == 2u ? pc.w2 : pc.w3;
    uint boff = seg == 0u ? pc.b0 : seg == 1u ? pc.b1 : seg == 2u ? pc.b2 : pc.b3;
    uint ty = TY != 255u ? TY : (pc.types >> (4u * seg)) & 0xFu, tyu = TYU != 255u ? TYU : (pc.types >> 16u) & 0xFu;
    uint ie = item_elems(ty), nit = pc.K / ie, xs4 = ie / 4u;
    float acc = 0.0, acc2 = 0.0, nv = 0.0;
    if (valid) {
        uint rb = woff + lrow * row_bytes_of(ty, pc.K);
#ifdef SWIGLU
        uint rbu = pc.wup + lrow * row_bytes_of(tyu, pc.K);
#endif
