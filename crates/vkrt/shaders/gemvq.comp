        uint a1 = odd ? ((w[qlw + 8u + k] >> 16) | (w[qlw + 9u + k] << 16)) : w[qlw + 8u + k];
        uint h = odd ? ((w[qhw + k] >> 16) | (w[qhw + k + 1u] << 16)) : w[qhw + k];
        uint v[4];
