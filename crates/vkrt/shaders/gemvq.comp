        v[1] = (a1 & 0x0F0F0F0Fu) | (((h >> 2) & 0x03030303u) << 4);
        v[2] = ((a0 >> 4) & 0x0F0F0F0Fu) | (((h >> 4) & 0x03030303u) << 4);
        v[3] = ((a1 >> 4) & 0x0F0F0F0Fu) | (((h >> 6) & 0x03030303u) << 4);
