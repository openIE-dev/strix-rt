void main_q4p() {
    uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint rps = gl_SubgroupSize / LPR, lane = gl_SubgroupInvocationID % LPR;
    uint row = (wg * gl_NumSubgroups + gl_SubgroupID) * rps + gl_SubgroupInvocationID / LPR;
    bool valid = row < pc.N;
    uint seg = row < pc.r1 ? 0u : row < pc.r2 ? 1u : row < pc.r3 ? 2u : 3u;
    uint lrow = row - (seg == 0u ? 0u : seg == 1u ? pc.r1 : seg == 2u ? pc.r2 : pc.r3);
    uint woff = seg == 0u ? pc.w0 : seg == 1u ? pc.w1 : seg == 2u ? pc.w2 : pc.w3;
    uint boff = seg == 0u ? pc.b0 : seg == 1u ? pc.b1 : seg == 2u ? pc.b2 : pc.b3;
    float acc = 0.0, nv = 0.0;
    if (valid) {
        if (TY == 0u) { uint rb = woff + lrow * row_bytes_of(0u, pc.K), np = pc.K / 64u;
            if ((Q4P & 8u) != 0u) { for (uint p = lane; p < np; p += LPR) acc += q4k_pair_i(rb, p); }
            else { for (uint p = lane; p < np; p += LPR) acc += q4k_pair(rb, p); } }
        else { uint rb = woff + lrow * row_bytes_of(1u, pc.K);
            if ((Q4P & 64u) != 0u) { uint nq = pc.K / 128u; for (uint qd = lane; qd < nq; qd += LPR) acc += q6k_quad(rb, qd); }
            else { uint ni = pc.K / 32u; for (uint it = lane; it < ni; it += LPR) acc += q6k_al(rb, it); } }
    }
    acc = subgroupClusteredAdd(acc, LPR);
    float scale = ((pc.flags & 4u) != 0u) ? inversesqrt(sq[pc.sq_in] / float(pc.K) + pc.eps) : 1.0;
    acc *= scale;
    if (valid && lane == 0u) {
        if (boff != 0xFFFFFFFFu) acc += f32w[boff + lrow];
        uint o = pc.y_off + row;
        nv = ((pc.flags & 1u) != 0u) ? y[o] + acc : acc;
        y[o] = nv;
        if ((pc.flags & 16u) != 0u) xw[o] = nv * f32w[pc.norm_off + row];
    }
    if ((pc.flags & 8u) != 0u) {
        float t2 = subgroupAdd((valid && lane == 0u) ? nv * nv : 0.0);
        if (subgroupElect()) red[gl_SubgroupID] = t2;
        barrier();
        float t = 0.0; if (gl_LocalInvocationID.x == 0u) { for (uint i = 0u; i < gl_NumSubgroups; i++) t += red[i]; }
        sq_commit(0u, t);
    }
}
