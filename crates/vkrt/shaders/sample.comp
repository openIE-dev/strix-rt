#version 450
// Greedy: toks[pos+1] = argmax (unless still inside the prompt); pos++.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer AU { uint au[]; };
layout(std430, binding = 1) buffer T { uint toks[]; };
#ifndef AUX_KEY
#define AUX_KEY 64u
#define AUX_POS 80u
#define AUX_PLEN 81u
#endif
void main() {
    uint p = au[AUX_POS], idx = ~au[AUX_KEY];
    if (p + 1u >= au[AUX_PLEN]) toks[p + 1u] = idx;
#ifdef AUX_PRED
    if (au[AUX_PRED] != 0u) toks[au[AUX_PRED] + p + 1u] = idx; // teacher-forced eval: record every prediction
#endif
    au[AUX_POS] = p + 1u;
}
