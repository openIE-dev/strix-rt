#version 450
// Per-head RMSNorm on q and k (head_dim 64, weights q_norm/k_norm), NeoX RoPE at pos = au[160], k/v stored to f16 cache.
// qkv = [q (n_head*64) | k (n_kv*64) | v (n_kv*64)]. One workgroup of 64 per q head or kv head.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Q { float qkv[]; };
layout(std430, binding = 1) buffer KC { float16_t kc[]; };
layout(std430, binding = 2) buffer VC { float16_t vc[]; };
layout(std430, binding = 3) readonly buffer AU { uint au[]; };
layout(std430, binding = 4) readonly buffer F { float f32w[]; };
layout(push_constant) uniform PC { uint n_head; uint n_kv; uint cache_off; float theta; uint qn; uint kn; float eps; } pc;
shared float red[4]; shared float xs[64];
void main() {
    uint h = gl_WorkGroupID.x, i = gl_LocalInvocationID.x, pos = au[160];
    bool isq = h < pc.n_head; uint kh = h - pc.n_head;
    uint o = isq ? h * 64u : pc.n_head * 64u + kh * 64u;
    float v = qkv[o + i];
    float ss = subgroupAdd(v * v);
    if (subgroupElect()) red[gl_SubgroupID] = ss;
    barrier();
    float tot = 0.0; for (uint s = 0u; s < gl_NumSubgroups; s++) tot += red[s];
    float xn = v * inversesqrt(tot / 64.0 + pc.eps) * f32w[(isq ? pc.qn : pc.kn) + i];
    xs[i] = xn;
    barrier();
    uint j = i & 31u;
    float a = float(pos) * pow(pc.theta, -float(2u * j) / 64.0);
    float c = cos(a), s = sin(a);
    float r = i < 32u ? xs[i] * c - xs[i + 32u] * s : xs[i - 32u] * s + xs[i] * c;
    if (isq) { qkv[o + i] = r; }
    else {
        uint co = pc.cache_off + pos * pc.n_kv * 64u + kh * 64u;
        kc[co + i] = float16_t(r);
        vc[co + i] = float16_t(qkv[pc.n_head * 64u + pc.n_kv * 64u + kh * 64u + i]);
    }
}
