#version 450
// NeoX RoPE on q,k (in the fused qkv buffer) at pos = aux[80]; k,v stored to an f16 cache.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Q { float qkv[]; };
layout(std430, binding = 1) buffer KC { float16_t kc[]; };
layout(std430, binding = 2) buffer VC { float16_t vc[]; };
layout(std430, binding = 3) readonly buffer AU { uint au[]; };
layout(push_constant) uniform PC { uint n_head; uint n_kv; uint cache_off; float theta; } pc;
void main() {
    uint h = gl_WorkGroupID.x, i = gl_LocalInvocationID.x, pos = au[80];
    float a = float(pos) * pow(pc.theta, -float(2u * i) / 128.0);
    float c = cos(a), s = sin(a);
    if (h < pc.n_head) {
        uint o = h * 128u; float x0 = qkv[o + i], x1 = qkv[o + i + 64u];
        qkv[o + i] = x0 * c - x1 * s; qkv[o + i + 64u] = x0 * s + x1 * c;
    } else {
        uint kh = h - pc.n_head, ko = pc.n_head * 128u + kh * 128u, vo = pc.n_head * 128u + pc.n_kv * 128u + kh * 128u;
        float x0 = qkv[ko + i], x1 = qkv[ko + i + 64u];
        uint co = pc.cache_off + pos * pc.n_kv * 128u + kh * 128u;
        kc[co + i] = float16_t(x0 * c - x1 * s); kc[co + i + 64u] = float16_t(x0 * s + x1 * c);
        vc[co + i] = float16_t(qkv[vo + i]); vc[co + i + 64u] = float16_t(qkv[vo + i + 64u]);
    }
}
