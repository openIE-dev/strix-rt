#version 450
// y[t*ld + c0 + i] = clamp(y[..], lo, hi) for i < K, t = workgroup y (Gemma4ClippableLinear output clamp)
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Y { float y[]; };
layout(push_constant) uniform PC { uint K; uint ld; uint c0; float lo; float hi; } pc;
void main() { uint i = gl_GlobalInvocationID.x; if (i >= pc.K) return; uint o = gl_WorkGroupID.y * pc.ld + pc.c0 + i; y[o] = clamp(y[o], pc.lo, pc.hi); }
