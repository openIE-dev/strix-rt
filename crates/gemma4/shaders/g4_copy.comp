#version 450
// dst[d_off + i] = src[s_off + i], i < n
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer S { float s[]; };
layout(std430, binding = 1) writeonly buffer D { float d[]; };
layout(push_constant) uniform PC { uint n; uint s_off; uint d_off; } pc;
void main() { uint i = gl_GlobalInvocationID.x; if (i < pc.n) d[pc.d_off + i] = s[pc.s_off + i]; }
