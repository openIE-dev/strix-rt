#version 450
// Gemma 4 prefill: f32 rows -> f16 GEMM input A[t * lda + i], i < K, t < M (workgroup y = row t).
//   mode 0: a = x[t*xcs + i] * f
//   mode 1: a = gelu_tanh(x[t*xcs + i]) * x[t*xcs + K + i]                 (GeGLU, gate | up halves)
//   result clamped to [lo, hi] (Gemma4ClippableLinear input clamp; +-65504 otherwise)
//   mode 2: a = gelu_tanh(x[t*xcs + i] * f) * b[b_off + t*bcs + i]          (PLE gate)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer A { float16_t a[]; };
layout(push_constant) uniform PC { uint K; uint lda; uint xcs; uint mode; float f; uint b_off; uint bcs; float lo; float hi; } pc;
float gelu(float v) { const float c = 0.7978845608028654; return 0.5 * v * (1.0 + tanh(clamp(c * (v + 0.044715 * v * v * v), -15.0, 15.0))); }
void main() {
    uint i = gl_GlobalInvocationID.x, t = gl_WorkGroupID.y;
    if (i >= pc.K) return;
    uint xi = t * pc.xcs + i; float r;
    if (pc.mode == 0u) r = x[xi] * pc.f;
    else if (pc.mode == 1u) r = gelu(x[xi]) * x[xi + pc.K];
    else r = gelu(x[xi] * pc.f) * b[pc.b_off + t * pc.bcs + i];
    a[t * pc.lda + i] = float16_t(clamp(r, max(pc.lo, -65504.0), min(pc.hi, 65504.0)));
}
