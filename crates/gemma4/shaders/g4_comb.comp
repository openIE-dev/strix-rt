#version 450
// Merge NC split-K attention partials per head (no sink). D = head dim (spec constant).
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint D = 256u;
layout(std430, binding = 0) readonly buffer P { float part[]; };
layout(std430, binding = 1) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint nc; uint o_off; uint o_cs; uint n_head; } pc;
void main() {
    uint h = gl_WorkGroupID.x, hp = gl_WorkGroupID.y * pc.n_head + h;
    float M = -1e30;
    for (uint c = 0u; c < pc.nc; c++) M = max(M, part[(hp * pc.nc + c) * (2u + D)]);
    float L = 0.0;
    for (uint c = 0u; c < pc.nc; c++) { uint b = (hp * pc.nc + c) * (2u + D); L += exp(part[b] - M) * part[b + 1u]; }
    for (uint i = gl_LocalInvocationID.x; i < D; i += 64u) {
        float a = 0.0;
        for (uint c = 0u; c < pc.nc; c++) { uint b = (hp * pc.nc + c) * (2u + D); a += exp(part[b] - M) * part[b + 2u + i]; }
        o[pc.o_off + gl_WorkGroupID.y * pc.o_cs + h * D + i] = a / L;
    }
}
