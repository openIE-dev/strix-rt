#version 450
// Routed-expert gate+up (fused SwiGLU), B-bit quant slots. Grid: x = row/8, y = expert slot. N=2560, K=5120.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint BITS0 = 2;
layout(constant_id = 1) const uint MIXED = 0;
layout(constant_id = 2) const uint ABM = 0;
layout(constant_id = 3) const uint CB = 0;
layout(std430, binding = 0) readonly buffer SW { uint cw[]; };
layout(std430, binding = 1) readonly buffer SS { uint ss[]; };
layout(std430, binding = 2) readonly buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer H { float h[]; };
layout(std430, binding = 4) readonly buffer M { float meta[]; };
layout(push_constant) uniform PC { uint n; uint k; uint slot_bytes; uint wproj_bytes; uint s_base; uint sproj_bytes; uint topk; float lut[8]; } pc;
#include "qcommon.glsl"
void main() {
    uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID, e = gl_WorkGroupID.y, ln = gl_SubgroupInvocationID;
    if (r >= pc.n) return;
    uint kg = pc.k >> 5; uint sb = floatBitsToUint(meta[e * 8u + 4u]) * pc.slot_bytes;
    uint BITS = MIXED != 0u ? floatBitsToUint(meta[e * 8u + 5u]) : BITS0; uint wpb = MIXED != 0u ? 1638400u * BITS : pc.wproj_bytes; uint sbase = MIXED != 0u ? 3u * wpb : pc.s_base;
    uint gw = (sb + wpb) >> 2, uw = (sb + 2u * wpb) >> 2;
    uint gs = sb + sbase + pc.sproj_bytes, us = sb + sbase + 2u * pc.sproj_bytes;
    float ag = 0.0, au = 0.0;
    for (uint j = ln; j < kg; j += 32u) {
        ag += qdot32(gw + (r * kg + j) * BITS, scale16(gs + (r * kg + j) * 2u), j * 32u, BITS);
        au += qdot32(uw + (r * kg + j) * BITS, scale16(us + (r * kg + j) * 2u), j * 32u, BITS);
    }
    ag = subgroupAdd(ag); au = subgroupAdd(au);
    if (subgroupElect()) { float g = ag, u = au; h[e * pc.n + r] = g / (1.0 + exp(-g)) * u; }
}
