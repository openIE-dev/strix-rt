#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer G { float g[]; };
layout(std430, binding = 1) readonly buffer U { float u[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() { uint i = gl_GlobalInvocationID.x; if (i < pc.n) { float a = g[i]; g[i] = a / (1.0 + exp(-a)) * u[i]; } }
