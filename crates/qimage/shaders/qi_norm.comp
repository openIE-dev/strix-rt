#version 450
// Row norms (one workgroup per row, D <= 4096) -> f16 GEMM operand A[t*lda + i]:
//  mode 0: RMSNorm * (P[w_off + i] + wplus)               (Qwen3 RMSNorm: wplus 0; zero-centred RMSNorm: wplus 1)
//  mode 1: LayerNorm (no affine) * (1 + M[s_off + i])     (DiT adaptive modulation, scale only)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer A { float16_t a[]; };
layout(std430, binding = 2) readonly buffer P { float pr[]; };
layout(std430, binding = 3) readonly buffer M { float md[]; };
layout(push_constant) uniform PC { uint D; uint ldx; uint lda; uint w_off; float wplus; uint mode; float eps; uint s_off; } pc;
shared float red[16];
float wsum(float v) { v = subgroupAdd(v); if (subgroupElect()) red[gl_SubgroupID] = v; barrier();
    float s = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) s += red[i]; barrier(); return s; }
void main() {
    uint t = gl_WorkGroupID.x, i0 = gl_LocalInvocationID.x, xb = t * pc.ldx;
    float v[16]; float s = 0.0, q = 0.0;
    for (uint c = 0u; c < 16u; c++) { uint i = i0 + c * 256u; v[c] = i < pc.D ? x[xb + i] : 0.0; s += v[c]; q += v[c] * v[c]; }
    if (pc.mode == 0u) {
        float r = inversesqrt(wsum(q) / float(pc.D) + pc.eps);
        for (uint c = 0u; c < 16u; c++) { uint i = i0 + c * 256u; if (i >= pc.D) break; a[t * pc.lda + i] = float16_t(v[c] * r * (pr[pc.w_off + i] + pc.wplus)); }
    } else {
        float mean = wsum(s) / float(pc.D); float d2 = 0.0;
        for (uint c = 0u; c < 16u; c++) { uint i = i0 + c * 256u; if (i < pc.D) { float d = v[c] - mean; d2 += d * d; } }
        float r = inversesqrt(wsum(d2) / float(pc.D) + pc.eps);
        for (uint c = 0u; c < 16u; c++) { uint i = i0 + c * 256u; if (i >= pc.D) break; a[t * pc.lda + i] = float16_t((v[c] - mean) * r * (1.0 + md[pc.s_off + i])); }
    }
}
