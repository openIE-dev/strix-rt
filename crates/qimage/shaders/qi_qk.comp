#version 450
// Per (token t, head h): optional RMSNorm over the 128-wide head (weight at P[w_off]), optional rotary embedding from a
// per-token table R[(t + rrow0) * 128 + 2p .. +1] = (cos, sin) of pair p, then f16 store to Dst[(drow0 + t) * ldd + h*128].
// style 0: pairs are adjacent elements (2p, 2p+1) (diffusers complex RoPE); style 1: pairs (p, p + 64) (HF rotate_half).
// flags: 1 = norm, 2 = rope.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Y { float y[]; };
layout(std430, binding = 1) writeonly buffer Dst { float16_t dst[]; };
layout(std430, binding = 2) readonly buffer P { float pr[]; };
layout(std430, binding = 3) readonly buffer R { float rt[]; };
layout(push_constant) uniform PC { uint nh; uint ldy; uint col0; uint w_off; float eps; uint ldd; uint drow0; uint style; uint flags; uint rrow0; } pc;
shared float red[4];
void main() {
    uint t = gl_WorkGroupID.x / pc.nh, h = gl_WorkGroupID.x % pc.nh, p = gl_LocalInvocationID.x;
    uint e0 = pc.style == 0u ? 2u * p : p, e1 = pc.style == 0u ? 2u * p + 1u : p + 64u;
    uint b = t * pc.ldy + pc.col0 + h * 128u;
    float x0 = y[b + e0], x1 = y[b + e1];
    if ((pc.flags & 1u) != 0u) {
        float ss = subgroupAdd(x0 * x0 + x1 * x1); if (subgroupElect()) red[gl_SubgroupID] = ss; barrier();
        ss = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) ss += red[i];
        float r = inversesqrt(ss / 128.0 + pc.eps); x0 *= r * pr[pc.w_off + e0]; x1 *= r * pr[pc.w_off + e1];
    }
    if ((pc.flags & 2u) != 0u) {
        uint rb = (t + pc.rrow0) * 128u + 2u * p; float c = rt[rb], s = rt[rb + 1u];
        float y0 = x0 * c - x1 * s, y1 = x0 * s + x1 * c; x0 = y0; x1 = y1;
    }
    uint o = (pc.drow0 + t) * pc.ldd + h * 128u;
    dst[o + e0] = float16_t(x0); dst[o + e1] = float16_t(x1);
}
