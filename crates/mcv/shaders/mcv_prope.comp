#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
// mcv fork of prefill/pf_rope: rope positions per row from POS[t*4 + {0,1,2}] (t, h, w; interleaved M-RoPE
// sections [11,11,10]); the KV cache index stays pos0 + t.
// Batched rope_qkn: workgroup = (token t, head h < n_head + n_kv); q rotated in place in PR row t, k/v stored f16 at pos0+t.
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint D = 256u;
layout(std430, binding = 0) buffer Q { float qkv[]; };
layout(std430, binding = 1) buffer KC { float16_t kc[]; };
layout(std430, binding = 2) buffer VC { float16_t vc[]; };
layout(std430, binding = 3) readonly buffer F { float f32w[]; };
layout(std430, binding = 4) readonly buffer PS { uint ps[]; };
layout(push_constant) uniform PC { uint n_head; uint n_kv; uint cache_off; float theta; uint qn; uint kn; float eps; uint q_stride; uint k_base; uint v_base; uint n_rot; uint pos0; uint ldp; } pc;
shared float red[16]; shared float xs[D];
void main() {
    uint nhh = pc.n_head + pc.n_kv;
    uint g = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint h = g % nhh, t = g / nhh, i = gl_LocalInvocationID.x, pos = pc.pos0 + t, rb = t * pc.ldp;
    bool isq = h < pc.n_head; uint kh = h - pc.n_head;
    uint o = rb + (isq ? h * pc.q_stride : pc.k_base + kh * D);
    float v = qkv[o + i];
    float ss = subgroupAdd(v * v);
    if (subgroupElect()) red[gl_SubgroupID] = ss;
    barrier();
    float tot = 0.0; for (uint s = 0u; s < gl_NumSubgroups; s++) tot += red[s];
    float xn = v * inversesqrt(tot / float(D) + pc.eps) * f32w[(isq ? pc.qn : pc.kn) + i];
    xs[i] = xn;
    barrier();
    float r = xn;
    uint half_ = pc.n_rot / 2u;
    if (i < pc.n_rot) {
        uint j = i % half_;
        uint p = (j % 3u == 1u && j < 33u) ? ps[t * 4u + 1u] : ((j % 3u == 2u && j < 30u) ? ps[t * 4u + 2u] : ps[t * 4u]);
        float a = float(p) * pow(pc.theta, -float(2u * j) / float(pc.n_rot));
        float c = cos(a), s = sin(a);
        r = i < half_ ? xs[i] * c - xs[i + half_] * s : xs[i - half_] * s + xs[i] * c;
    }
    if (isq) { qkv[o + i] = r; }
    else {
        uint co = pc.cache_off + pos * pc.n_kv * D + kh * D;
        kc[co + i] = float16_t(r);
        vc[co + i] = float16_t(qkv[rb + pc.v_base + kh * D + i]);
    }
}
