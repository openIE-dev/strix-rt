#version 450
// Grouped multi-row MoE down projection for small prompts (Q6_K, K = 512 only): one workgroup per (tile, 64-row chunk).
// The tile's <= T rows of h (f16 [nk][ldx]) are staged in shared memory (T KB); each wave32 owns 8 output rows, lane L
// dequantizes 16 weights (superblock L/16, half (L/8)%2, l = 4(L%8)..+3 of the four 32-weight quadrants) and accumulates
// against all T rows. Q6_K blocks are 210 B, so the second block of a row is only 2-byte aligned (ld32 handles it).
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint T = 8u;
layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { uint x2[]; };   // f16 pairs
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(std430, binding = 3) readonly buffer G { uint gt[]; };
layout(push_constant) uniform PC { uint woff; uint estride; uint N; uint ldx; uint ldy; uint maxt; } pc;
const uint K = 512u, RB = 420u;
shared uint xs[T][K / 2u + K / 64u];
#define XI(c) ((c) + ((c) >> 5))
uint ld32(uint o) { uint a = w[o >> 2]; return (o & 3u) == 0u ? a : ((a >> 16) | (w[(o >> 2) + 1u] << 16)); }
int sx8(uint v, uint b) { return int(v << (24u - 8u * b)) >> 24; }
void main() {
    uint slot = gl_WorkGroupID.x % pc.maxt, ch = gl_WorkGroupID.x / pc.maxt;
    if (slot >= gt[0]) return;
    uint e = gt[1u + 3u * slot], r0 = gt[2u + 3u * slot], nr = gt[3u + 3u * slot] - r0;
    uint tid = gl_LocalInvocationID.x;
    for (uint i = tid; i < T * K / 2u; i += 256u) { uint t = i / (K / 2u), c = i % (K / 2u); xs[t][XI(c)] = t < nr ? x2[(r0 + t) * (pc.ldx / 2u) + c] : 0u; }
    barrier();
    uint L = gl_SubgroupInvocationID, wv = gl_SubgroupID;
    uint sb = L >> 4, hf = (L >> 3) & 1u, l = (L & 7u) * 4u, is = l >> 4;
    uint xb = (sb * 256u + hf * 128u + l) / 2u;   // half2 index of quadrant 0
    [[unroll]] for (uint rr = 0u; rr < 8u; rr++) {   // fully unrolled: lets the compiler hoist the 8 rows' weight loads
        uint n = ch * 64u + wv * 8u + rr;
        uint bo = pc.woff + e * pc.estride + n * RB + sb * 210u;
        uint qlA = ld32(bo + hf * 64u + l), qlB = ld32(bo + hf * 64u + 32u + l), qh = ld32(bo + 128u + hf * 32u + l);
        uint scw = ld32(bo + 192u + hf * 8u), scw2 = ld32(bo + 196u + hf * 8u);
        float d = unpackHalf2x16(ld32(bo + 208u) & 0xFFFFu).x;
        float s0 = d * float(sx8(is == 0u ? scw : scw, is)), s1 = d * float(sx8(scw, is + 2u)), s2 = d * float(sx8(scw2, is)), s3 = d * float(sx8(scw2, is + 2u));
        vec4 q0, q1, q2, q3;
        [[unroll]] for (uint b = 0u; b < 4u; b++) {
            uint a = (qlA >> (8u * b)) & 255u, c = (qlB >> (8u * b)) & 255u, h = (qh >> (8u * b)) & 255u;
            q0[b] = float(int((a & 15u) | ((h & 3u) << 4)) - 32);
            q1[b] = float(int((c & 15u) | (((h >> 2) & 3u) << 4)) - 32);
            q2[b] = float(int((a >> 4) | (((h >> 4) & 3u) << 4)) - 32);
            q3[b] = float(int((c >> 4) | (((h >> 6) & 3u) << 4)) - 32);
        }
        q0 *= s0; q1 *= s1; q2 *= s2; q3 *= s3;
        float acc[T];
        [[unroll]] for (uint t = 0u; t < T; t++) {
            vec4 a0 = vec4(unpackHalf2x16(xs[t][XI(xb)]), unpackHalf2x16(xs[t][XI(xb + 1u)]));
            vec4 a1 = vec4(unpackHalf2x16(xs[t][XI(xb + 16u)]), unpackHalf2x16(xs[t][XI(xb + 17u)]));
            vec4 a2 = vec4(unpackHalf2x16(xs[t][XI(xb + 32u)]), unpackHalf2x16(xs[t][XI(xb + 33u)]));
            vec4 a3 = vec4(unpackHalf2x16(xs[t][XI(xb + 48u)]), unpackHalf2x16(xs[t][XI(xb + 49u)]));
            acc[t] = dot(q0, a0) + dot(q1, a1) + dot(q2, a2) + dot(q3, a3);
        }
        [[unroll]] for (uint t = 0u; t < T; t++) { float v = subgroupAdd(acc[t]); if (L == 0u && t < nr) y[(r0 + t) * pc.ldy + n] = v; }
    }
}
