#version 450
// qwen35moe router logits a[e] = Wg[e] . rmsnorm(x) -> sq[176+e]; wave n_exp computes the shared-expert gate
// g = sigmoid(Wsh . rmsnorm(x)) and stores sq[170] = kd * (1/g^2 - eps) so a fused-norm input scale (flag 4,
// rsqrt(sq/kd + eps)) of the shared down GEMV equals g. One wave32 per expert.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer F4 { vec4 f32w4[]; };
layout(std430, binding = 1) readonly buffer XW { vec4 xw4[]; };
layout(std430, binding = 2) buffer A { float sq[]; };
layout(push_constant) uniform PC { uint w_off; uint sh_off; uint K; uint n_exp; uint slot; float eps; uint kd; } pc;
void main() {
    uint e = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    if (e > pc.n_exp) return;
    uint k4 = pc.K >> 2, wb = (e < pc.n_exp) ? (pc.w_off >> 2) + e * k4 : (pc.sh_off >> 2);
    float a = 0.0;
    for (uint k = gl_SubgroupInvocationID; k < k4; k += gl_SubgroupSize) a += dot(f32w4[wb + k], xw4[k]);
    a = subgroupAdd(a) * inversesqrt(sq[pc.slot] / float(pc.K) + pc.eps);
    if (subgroupElect()) {
        if (e < pc.n_exp) sq[176u + e] = a;
        else { float g = 1.0 / (1.0 + exp(-clamp(a, -30.0, 30.0))); sq[170] = float(pc.kd) * (1.0 / (g * g) - pc.eps); }
    }
}
