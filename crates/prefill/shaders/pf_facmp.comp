#version 450
// PF_FA_CMP debug: out[idx] = max |a - b| (as float bits) over n f16 elements; NaN/Inf -> +Inf bits
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer B { float16_t b[]; };
layout(std430, binding = 2) buffer O { uint o[]; };
layout(push_constant) uniform PC { uint n; uint idx; } pc;
void main() {
    float m = 0.0;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256u) {
        float d = abs(float(a[i]) - float(b[i]));
        if (isnan(d) || isinf(d)) d = 1.0 / 0.0;
        m = max(m, d);
    }
    if (m > 0.0) atomicMax(o[pc.idx], floatBitsToUint(m));
}
