#version 450
// f16 activations [M][lda] -> f32 [M][K] (input of the Bonsai Hadamard rotation / int8 quantization).
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) writeonly buffer X { float x[]; };
layout(push_constant) uniform PC { uint K; uint lda; uint M; } pc;
void main() {
    uint idx = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 256u + gl_LocalInvocationID.x;
    if (idx >= pc.K * pc.M) return;
    uint t = idx / pc.K, i = idx - t * pc.K;
    x[idx] = float(a[t * pc.lda + i]);
}
