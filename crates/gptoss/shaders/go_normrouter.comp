#version 450
// Fused post-attention RMSNorm + MoE router (one workgroup per column, column = workgroup y):
// xw = x * rsqrt(mean(x^2)+eps) * w (same arithmetic as go_norm), then go_router on xw.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 1024) in;
layout(std430, binding = 0) readonly buffer F { float f32w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer AU { uint au[]; };
layout(std430, binding = 2) buffer AF { float af[]; };
layout(std430, binding = 3) buffer XW { float xw[]; };
layout(push_constant) uniform PC { uint w_off; uint b_off; uint K; uint n_exp; uint top_k; uint norm_off; float eps; } pc;
shared float red[64];
shared float lg[64];
void main() {
    uint t = gl_LocalInvocationID.x, xo = gl_WorkGroupID.y * pc.K, ab = 16u * gl_WorkGroupID.y;
    float ss = 0.0;
    for (uint i = t; i < pc.K; i += 1024u) { float v = x[xo + i]; ss += v * v; }
    ss = subgroupAdd(ss);
    if (subgroupElect()) red[gl_SubgroupID] = ss;
    barrier();
    float tot = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) tot += red[i];
    float sc = inversesqrt(tot / float(pc.K) + pc.eps);
    for (uint i = t; i < pc.K; i += 1024u) xw[xo + i] = x[xo + i] * sc * f32w[pc.norm_off + i];
    memoryBarrierBuffer(); barrier();
    uint L = gl_SubgroupInvocationID, wv = gl_SubgroupID, nw = gl_NumSubgroups;
    for (uint e = wv; e < pc.n_exp; e += nw) {
        float s = 0.0;
        for (uint i = L; i < pc.K; i += gl_SubgroupSize) s += f32w[pc.w_off + e * pc.K + i] * xw[xo + i];
        s = subgroupAdd(s);
        if (subgroupElect()) lg[e] = s + f32w[pc.b_off + e];
    }
    barrier();
    if (t == 0u) {
        uint ids[8]; float v[8];
        for (uint j = 0u; j < pc.top_k; j++) {
            float bv = -3.4e38; uint bi = 0u;
            for (uint e = 0u; e < pc.n_exp; e++) { bool used = false; for (uint q = 0u; q < j; q++) used = used || ids[q] == e; if (!used && lg[e] > bv) { bv = lg[e]; bi = e; } }
            ids[j] = bi; v[j] = bv;
        }
        float sum = 0.0; for (uint j = 0u; j < pc.top_k; j++) { v[j] = exp(v[j] - v[0]); sum += v[j]; }
        for (uint j = 0u; j < pc.top_k; j++) { au[440u + ab + j] = ids[j]; af[448u + ab + j] = v[j] / sum; }
    }
}
