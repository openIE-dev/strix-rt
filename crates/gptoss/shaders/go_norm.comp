#version 450
// RMSNorm (one workgroup): xw = x * rsqrt(mean(x^2) + eps) * w. Optionally zeroes the argmax key (au[key], au[key+1]).
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 1024) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer XW { float xw[]; };
layout(std430, binding = 2) buffer AU { uint au[]; };
layout(std430, binding = 3) readonly buffer F { float f32w[]; };
layout(push_constant) uniform PC { uint K; uint norm_off; float eps; uint key_word; } pc;
shared float red[64];
void main() {
    uint t = gl_LocalInvocationID.x, xo = gl_WorkGroupID.y * pc.K;
    float ss = 0.0;
    for (uint i = t; i < pc.K; i += 1024u) { float v = x[xo + i]; ss += v * v; }
    ss = subgroupAdd(ss);
    if (subgroupElect()) red[gl_SubgroupID] = ss;
    barrier();
    float tot = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) tot += red[i];
    float sc = inversesqrt(tot / float(pc.K) + pc.eps);
    for (uint i = t; i < pc.K; i += 1024u) xw[xo + i] = x[xo + i] * sc * f32w[pc.norm_off + i];
    if (t == 0u && pc.key_word != 0u) { au[pc.key_word] = 0u; au[pc.key_word + 1u] = 0u; }
}
