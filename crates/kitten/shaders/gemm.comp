#version 450
// C[b][m,n] = sum_k A[b][m,k] * B[b][n,k] (+ bias[n]); arbitrary strides. mode 1: implicit-GEMM conv1d, B[n=t,k=(c,kw)] = x[c, t*s + kw*d - pad]
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { float m[]; };
layout(push_constant) uniform P { uint M, N, K, mode; uint a_off; int a_sm, a_sk, a_sb; uint b_off; int b_sn, b_sk, b_sb; uint c_off; int c_sm, c_sn, c_sb; uint bias_off; int bias_sb;
    uint L, KW, cs, cp, cd; int x_sc, x_sl; uint epi; float dv; uint r_off; int r_sm, r_sn; } p;
float erf_(float x) { float s = sign(x); x = abs(x); float t = 1.0 / (1.0 + 0.3275911 * x);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x); return s * y; }
// fused epilogue (mode 0 only): 1 = divide by dv, 2 = exact gelu, 4 = add residual r[gm, gn]
float epi(float v, uint gm, uint gn) { if ((p.epi & 1u) != 0u) v = v / p.dv; if ((p.epi & 2u) != 0u) v = 0.5 * v * (1.0 + erf_(v * 0.70710678118654752));
    if ((p.epi & 4u) != 0u) v += m[int(p.r_off) + int(gm) * p.r_sm + int(gn) * p.r_sn]; return v; }
shared float As[16][65]; shared float Bs[16][65];
void main() {
    uint tid = gl_LocalInvocationID.x; uint tm = gl_WorkGroupID.y * 64u, tn = gl_WorkGroupID.x * 64u; uint bz = gl_WorkGroupID.z;
    int ab = int(p.a_off) + int(bz) * p.a_sb, bb = int(p.b_off) + int(bz) * p.b_sb, cb = int(p.c_off) + int(bz) * p.c_sb;
    uint ty = tid / 16u, tx = tid % 16u; float acc[4][4];
    for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++) acc[i][j] = 0.0;
    for (uint k0 = 0u; k0 < p.K; k0 += 16u) {
        for (uint e = tid; e < 1024u; e += 256u) {
            uint r = e / 16u, kk = e % 16u; uint gm = tm + r, gk = k0 + kk;
            As[kk][r] = (gm < p.M && gk < p.K) ? m[ab + int(gm) * p.a_sm + int(gk) * p.a_sk] : 0.0;
            uint gn = tn + r; float bv = 0.0;
            if (gn < p.N && gk < p.K) {
                if (p.mode == 0u) bv = m[bb + int(gn) * p.b_sn + int(gk) * p.b_sk];
                else { uint c = gk / p.KW, kw = gk % p.KW; int pos = int(gn * p.cs + kw * p.cd) - int(p.cp);
                    if (pos >= 0 && pos < int(p.L)) bv = m[bb + int(c) * p.x_sc + pos * p.x_sl]; }
            }
            Bs[kk][r] = bv;
        }
        barrier();
        for (uint kk = 0u; kk < 16u; kk++) {
            float a[4], b[4];
            for (int i = 0; i < 4; i++) a[i] = As[kk][ty + 16u * i];
            for (int j = 0; j < 4; j++) b[j] = Bs[kk][tx + 16u * j];
            for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++) acc[i][j] = fma(a[i], b[j], acc[i][j]);
        }
        barrier();
    }
    for (int i = 0; i < 4; i++) { uint gm = tm + ty + 16u * i; if (gm >= p.M) continue;
        for (int j = 0; j < 4; j++) { uint gn = tn + tx + 16u * j; if (gn >= p.N) continue;
            float bias = p.bias_off != 0xffffffffu ? (p.mode == 0u ? m[p.bias_off + gn] : m[int(p.bias_off) + int(bz) * p.bias_sb + int(gm)]) : 0.0;
            m[cb + int(gm) * p.c_sm + int(gn) * p.c_sn] = epi(acc[i][j] + bias, gm, gn); } }
}
