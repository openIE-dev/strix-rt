#version 450
// LayerNorm (mean/variance, weight only, no bias): y = (x - mean) * rsqrt(var + eps) * w. One workgroup, n <= any.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer Y { float y[]; };
layout(std430, binding = 2) readonly buffer F { float f[]; };
layout(push_constant) uniform PC { uint n; uint w_off; float eps; } pc;
shared float r1[8], r2[8];
void main() {
    uint t = gl_LocalInvocationID.x;
    float s = 0.0; for (uint i = t; i < pc.n; i += 256u) s += x[i];
    s = subgroupAdd(s); if (subgroupElect()) r1[gl_SubgroupID] = s;
    barrier();
    float tot = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) tot += r1[i];
    float mean = tot / float(pc.n);
    float v = 0.0; for (uint i = t; i < pc.n; i += 256u) { float d = x[i] - mean; v += d * d; }
    v = subgroupAdd(v); if (subgroupElect()) r2[gl_SubgroupID] = v;
    barrier();
    float tv = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) tv += r2[i];
    float sc = inversesqrt(tv / float(pc.n) + pc.eps);
    for (uint i = t; i < pc.n; i += 256u) y[i] = (x[i] - mean) * sc * f[pc.w_off + i];
}
