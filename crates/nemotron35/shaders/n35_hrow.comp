#version 450
// hbuf[i] = seed[aux[166] * n + i]
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer S { float s[]; };
layout(std430, binding = 1) writeonly buffer H { float h[]; };
layout(std430, binding = 2) readonly buffer A { uint aux[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() { uint b = aux[166] * pc.n; for (uint i = gl_LocalInvocationID.x; i < pc.n; i += 256u) h[i] = s[b + i]; }
