#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// LatentMoE combine: A[t * lda + i] (f16) = sum_s w[t,s] * Yd[inv[t*tk+s]][i], i < lat. r = router output (weights at M*tk), g = [src | inv].
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer X { float16_t x[]; };
layout(std430, binding = 1) readonly buffer Y { float yd[]; };
layout(std430, binding = 2) readonly buffer R { uint r[]; };
layout(std430, binding = 3) readonly buffer I { uint g[]; };
layout(push_constant) uniform PC { uint lat; uint M; uint tk; uint lda; } pc;
void main() {
    uint idx = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 256u + gl_LocalInvocationID.x;
    if (idx >= pc.lat * pc.M) return;
    uint t = idx / pc.lat, i = idx - t * pc.lat, n = pc.M * pc.tk;
    float s = 0.0;
    for (uint j = 0u; j < pc.tk; j++) { uint q = t * pc.tk + j; s += uintBitsToFloat(r[n + q]) * yd[g[n + q] * pc.lat + i]; }
    x[t * pc.lda + i] = float16_t(s);
}
