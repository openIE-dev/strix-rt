#version 450
// 2x2 pixel-unshuffle of grid X[xoff + (h*Wp + w)][C] -> CAT[(i*(Wp/2) + j)][4C] = [x(2i,2j) | x(2i,2j+1) | x(2i+1,2j) | x(2i+1,2j+1)]
// (llama.cpp clip build_patch_merge_permute order). One thread per CAT element.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer CT { float cat[]; };
layout(push_constant) uniform PC { uint Hp; uint Wp; uint C; uint xoff; } pc;
void main() {
    uint g = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    uint w2 = pc.Wp / 2u, no = (pc.Hp / 2u) * w2, C4 = 4u * pc.C;
    if (g >= no * C4) return;
    uint o = g / C4, f = g - o * C4, q = f / pc.C, c = f - q * pc.C;
    uint i = o / w2, j = o - i * w2;
    uint src = (2u * i + (q >> 1)) * pc.Wp + 2u * j + (q & 1u);
    cat[g] = x[(pc.xoff + src) * pc.C + c];
}
