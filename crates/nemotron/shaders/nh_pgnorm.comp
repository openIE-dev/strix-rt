#version 450
// Batched grouped RMSNorm: workgroup (g, t) normalizes y[t][g*n..] and writes f16 activations a[t*lda + g*n + i].
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Y { float y[]; };
layout(std430, binding = 1) writeonly buffer A { float16_t a[]; };
layout(std430, binding = 2) readonly buffer F { float f[]; };
layout(push_constant) uniform PC { uint n; uint w_off; float eps; uint d; uint lda; } pc;
shared float red[8];
void main() {
    uint g = gl_WorkGroupID.x, t = gl_WorkGroupID.y, l = gl_LocalInvocationID.x, b = t * pc.d + g * pc.n;
    float s = 0.0; for (uint i = l; i < pc.n; i += 256u) { float v = y[b + i]; s += v * v; }
    s = subgroupAdd(s); if (subgroupElect()) red[gl_SubgroupID] = s;
    barrier();
    float tot = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) tot += red[i];
    float sc = inversesqrt(tot / float(pc.n) + pc.eps);
    for (uint i = l; i < pc.n; i += 256u) a[t * pc.lda + g * pc.n + i] = float16_t(y[b + i] * sc * f[pc.w_off + g * pc.n + i]);
}
