#version 450
// Batched squared ReLU: a[t*lda + i] = f16(max(y[t*ldy + i], 0)^2).
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Y { float y[]; };
layout(std430, binding = 1) writeonly buffer A { float16_t a[]; };
layout(push_constant) uniform PC { uint n; uint ldy; uint lda; } pc;
void main() { uint i = gl_GlobalInvocationID.x, t = gl_WorkGroupID.y; if (i < pc.n) { float v = max(y[t * pc.ldy + i], 0.0); a[t * pc.lda + i] = float16_t(v * v); } }
