#version 450
// Store this token's K and V (f32 rows of the fused qkv output) into the f16 caches at position au[pos_word].
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Q { float qkv[]; };
layout(std430, binding = 1) writeonly buffer KC { float16_t kc[]; };
layout(std430, binding = 2) writeonly buffer VC { float16_t vc[]; };
layout(std430, binding = 3) readonly buffer AU { uint au[]; };
layout(push_constant) uniform PC { uint n; uint k_off; uint v_off; uint cache_off; uint pos_word; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x; if (i >= pc.n) return;
    uint o = pc.cache_off + au[pc.pos_word] * pc.n + i;
    kc[o] = float16_t(qkv[pc.k_off + i]); vc[o] = float16_t(qkv[pc.v_off + i]);
}
