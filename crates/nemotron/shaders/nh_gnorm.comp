#version 450
// Grouped RMSNorm in place: workgroup g normalizes y[g*n .. (g+1)*n) and scales by w.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Y { float y[]; };
layout(std430, binding = 1) readonly buffer F { float f[]; };
layout(push_constant) uniform PC { uint n; uint w_off; float eps; } pc;
shared float red[8];
void main() {
    uint g = gl_WorkGroupID.x, t = gl_LocalInvocationID.x, b = g * pc.n;
    float s = 0.0; for (uint i = t; i < pc.n; i += 256u) { float v = y[b + i]; s += v * v; }
    s = subgroupAdd(s); if (subgroupElect()) red[gl_SubgroupID] = s;
    barrier();
    float tot = 0.0; for (uint i = 0u; i < gl_NumSubgroups; i++) tot += red[i];
    float sc = inversesqrt(tot / float(pc.n) + pc.eps);
    for (uint i = t; i < pc.n; i += 256u) y[b + i] = y[b + i] * sc * f[pc.w_off + b + i];
}
