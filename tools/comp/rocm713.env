# source me: ROCm 7.13.0 (release) (TheRock gfx1151 wheels in ~/venvs/rocm713)
R=~/venvs/rocm713/lib/python3.12/site-packages/_rocm_sdk_devel
export ROCM_PATH=$R HIP_PATH=$R PATH=$R/bin:$PATH LD_LIBRARY_PATH=$R/lib:$R/lib/llvm/lib:$LD_LIBRARY_PATH HIPCXX=$R/lib/llvm/bin/clang
export ROCBLAS_USE_HIPBLASLT=1
